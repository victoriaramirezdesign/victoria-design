# ------------------------------------------------------------------
# Victoria Design — variables de entorno
# Copia este archivo a .env.local para desarrollo. En produccion se
# configuran en Vercel > Project > Settings > Environment Variables.
# PostHog, Sentry y la URL de Supabase ya tienen un valor por defecto
# en el codigo (src/lib/env-defaults.ts) — no son secretos. Solo hace
# falta cargar aqui las 2 claves realmente secretas que faltan.
# NUNCA subas .env.local a GitHub. Guia paso a paso: ver SETUP.md
# ------------------------------------------------------------------

# URL publica del sitio (metadata, sitemap, OG).
NEXT_PUBLIC_SITE_URL=https://victoriadesign.pe

# --- Supabase — guardar leads -------------------------------------
# Proyecto ya creado (URL por defecto en env-defaults.ts).
# Falta SOLO la clave secreta: Dashboard > Project Settings > API Keys > service_role
SUPABASE_URL=https://aefhxsezkolcxcoqylup.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend — correos de leads ----------------------------------
# Dominio victoriadesign.pe ya verificado. Falta SOLO la clave secreta
# (se genero una restringida a este dominio, ver el chat / SETUP.md).
RESEND_API_KEY=
LEADS_FROM_EMAIL="Victoria Design <hola@victoriadesign.pe>"
LEADS_TO_EMAIL=hola@victoriadesign.pe

# --- PostHog — analitica --------------------------------------
# Ya tiene clave por defecto en env-defaults.ts. Solo completar si
# quieren usar OTRO proyecto de PostHog.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Sentry — monitoreo de errores ---------------------------
# Ya tiene DSN por defecto en env-defaults.ts. Para subir source maps
# en el build (opcional) completar org/project/token:
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Clerk — login de clientes (aun NO cableado) ---------------
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

# --- Pagos (Peru) — aun NO cableado ---------------------------
# Flow.cl NO opera en Peru. Elegir: Culqi, Izipay o Mercado Pago.
